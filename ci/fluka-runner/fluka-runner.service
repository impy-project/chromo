# systemd unit: one ephemeral runner container per job, restarted after each.
# Install (rootful Docker):  /etc/systemd/system/fluka-runner.service
# Install (rootless Docker): ~/.config/systemd/user/fluka-runner.service,
#   use `systemctl --user` and `loginctl enable-linger $USER`.
[Unit]
Description=chromo FLUKA GitHub Actions runner
After=docker.service network-online.target
Wants=network-online.target

[Service]
# directory with compose.yaml and gh_token
WorkingDirectory=/srv/chromo-fluka-runner
Environment=FLUKA_DIR=/srv/fluka/2025.1
ExecStart=/usr/bin/docker compose run --rm --name chromo-fluka-runner fluka-runner
ExecStop=/usr/bin/docker stop --time 30 chromo-fluka-runner
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
